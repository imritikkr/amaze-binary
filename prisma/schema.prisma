model BinaryPlacementHistory {
  id          String         @id @default(auto()) @map("_id") @db.ObjectId
  userId      String         @db.ObjectId
  oldParentId String?        @db.ObjectId
  newParentId String         @db.ObjectId
  position    BinaryPosition
  reason      String // "INITIAL_REGISTRATION", "ADMIN_CORRECTION", "SPILLOVER"
  performedBy String?        @db.ObjectId // Admin user ID or "SYSTEM"
  createdAt   DateTime       @default(now())

  @@index([userId])
  @@index([createdAt])
}

// 3. New Model: BinaryLegStatsHistory (Periodic/Daily snapshots for matching calculations)
model BinaryLegSnapshot {
  id         String   @id @default(auto()) @map("_id") @db.ObjectId
  userId     String   @db.ObjectId
  date       DateTime @default(now())
  leftCount  Int
  rightCount Int
  leftBv     Float
  rightBv    Float

  @@index([userId, date])
}

model EmailVerificationToken {
  id         String    @id @default(auto()) @map("_id") @db.ObjectId
  identifier String // Email address
  tokenHash  String    @unique
  expiresAt  DateTime
  consumedAt DateTime?
  createdAt  DateTime  @default(now())

  @@index([identifier])
}

model PasswordResetToken {
  id         String    @id @default(auto()) @map("_id") @db.ObjectId
  userId     String    @db.ObjectId
  tokenHash  String    @unique // SHA-256 hash of the single-use reset auth token
  expiresAt  DateTime
  consumedAt DateTime?
  createdAt  DateTime  @default(now())

  @@index([userId])
  @@index([expiresAt])
}

model AuthSession {
  id               String   @id @default(auto()) @map("_id") @db.ObjectId
  sessionTokenHash String   @unique // SHA-256 hash of the random session token
  userId           String   @db.ObjectId
  user             User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  userAgent        String?
  ipAddress        String?
  deviceInfo       String? // Parsed browser/OS summary
  lastActiveAt     DateTime @default(now())
  expiresAt        DateTime
  createdAt        DateTime @default(now())

  @@index([userId])
  @@index([expiresAt])
}

model LoginHistory {
  id        String   @id @default(auto()) @map("_id") @db.ObjectId
  userId    String   @db.ObjectId
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  ipAddress String?
  userAgent String?
  status    String // SUCCESS | FAILED
  reason    String?
  createdAt DateTime @default(now())

  @@index([userId])
}

model Kyc {
  id     String @id @default(auto()) @map("_id") @db.ObjectId
  userId String @unique @db.ObjectId
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  fullName       String
  fatherOrSpouse String
  dob            DateTime
  address        String
  state          String
  district       String
  pincode        String

  documents     KycDocument[]
  reviewHistory KycReviewHistory[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model KycDocument {
  id    String @id @default(auto()) @map("_id") @db.ObjectId
  kycId String @db.ObjectId
  kyc   Kyc    @relation(fields: [kycId], references: [id], onDelete: Cascade)

  documentType String // AADHAAR_FRONT | AADHAAR_BACK | PAN_CARD | PROFILE_IMAGE
  storagePath  String // Private object storage key / encrypted ref
  fileSize     Int
  mimeType     String
  uploadedAt   DateTime @default(now())

  @@index([kycId])
}

model KycReviewHistory {
  id    String @id @default(auto()) @map("_id") @db.ObjectId
  kycId String @db.ObjectId
  kyc   Kyc    @relation(fields: [kycId], references: [id], onDelete: Cascade)

  adminId String @db.ObjectId
  admin   User   @relation("AdminKycReviews", fields: [adminId], references: [id])

  status     KycStatus
  remarks    String?
  reviewedAt DateTime  @default(now())

  @@index([kycId])
}

model RegistrationIdempotency {
  id             String   @id @default(auto()) @map("_id") @db.ObjectId
  idempotencyKey String   @unique
  firebaseUid    String   @unique
  completedAt    DateTime @default(now())
}
