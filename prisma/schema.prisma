model BinaryPlacementHistory {
  id          String         @id @default(auto()) @map("_id") @db.ObjectId
  userId      String         @db.ObjectId
  oldParentId String?        @db.ObjectId
  newParentId String         @db.ObjectId
  position    BinaryPosition
  reason      String // "INITIAL_REGISTRATION", "ADMIN_CORRECTION", "SPILLOVER"
  performedBy String?        @db.ObjectId // Admin user ID or "SYSTEM"
  createdAt   DateTime       @default(now())

  @@index([userId])
  @@index([createdAt])
}

// 3. New Model: BinaryLegStatsHistory (Periodic/Daily snapshots for matching calculations)
model BinaryLegSnapshot {
  id         String   @id @default(auto()) @map("_id") @db.ObjectId
  userId     String   @db.ObjectId
  date       DateTime @default(now())
  leftCount  Int
  rightCount Int
  leftBv     Float
  rightBv    Float

  @@index([userId, date])
}

model EmailVerificationToken {
  id         String    @id @default(auto()) @map("_id") @db.ObjectId
  identifier String // Email address
  tokenHash  String    @unique
  expiresAt  DateTime
  consumedAt DateTime?
  createdAt  DateTime  @default(now())

  @@index([identifier])
}

model PasswordResetToken {
  id         String    @id @default(auto()) @map("_id") @db.ObjectId
  userId     String    @db.ObjectId
  tokenHash  String    @unique // SHA-256 hash of the single-use reset auth token
  expiresAt  DateTime
  consumedAt DateTime?
  createdAt  DateTime  @default(now())

  @@index([userId])
  @@index([expiresAt])
}

model AuthSession {
  id               String    @id @default(auto()) @map("_id") @db.ObjectId
  sessionTokenHash String    @unique // SHA-256 hash of the random session token
  userId           String    @db.ObjectId
  user             User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  userAgent        String?
  ipAddress        String?
  deviceInfo       String? // Parsed browser/OS summary
  lastActiveAt     DateTime  @default(now())
  expiresAt        DateTime
  createdAt        DateTime  @default(now())
  revokedAt        DateTime?

  @@index([userId])
  @@index([expiresAt])
}

model LoginHistory {
  id     String @id @default(auto()) @map("_id") @db.ObjectId
  userId String @db.ObjectId
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  ipAddress       String?
  userAgent       String?
  device          String?
  browser         String?
  operatingSystem String?
  status          String  @default("SUCCESS")
  reason          String?

  createdAt DateTime @default(now())

  @@index([userId, createdAt])
}

model Kyc {
  id     String @id @default(auto()) @map("_id") @db.ObjectId
  userId String @unique @db.ObjectId
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  fullName       String
  fatherOrSpouse String
  dob            DateTime
  address        String
  state          String
  district       String
  pincode        String

  documents     KycDocument[]
  reviewHistory KycReviewHistory[]

  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  submittedAt DateTime?
}

model KycDocument {
  id    String @id @default(auto()) @map("_id") @db.ObjectId
  kycId String @db.ObjectId
  kyc   Kyc    @relation(fields: [kycId], references: [id], onDelete: Cascade)

  documentType String // AADHAAR_FRONT | AADHAAR_BACK | PAN_CARD | PROFILE_IMAGE
  storagePath  String // Private object storage key / encrypted ref
  fileSize     Int
  mimeType     String
  uploadedAt   DateTime @default(now())

  @@index([kycId])
}

model KycReviewHistory {
  id    String @id @default(auto()) @map("_id") @db.ObjectId
  kycId String @db.ObjectId
  kyc   Kyc    @relation(fields: [kycId], references: [id], onDelete: Cascade)

  adminId String @db.ObjectId
  admin   User   @relation("AdminKycReviews", fields: [adminId], references: [id])

  status     KycStatus
  remarks    String?
  reviewedAt DateTime  @default(now())

  @@index([kycId])
}

model RegistrationIdempotency {
  id             String   @id @default(auto()) @map("_id") @db.ObjectId
  idempotencyKey String   @unique
  firebaseUid    String   @unique
  completedAt    DateTime @default(now())
}

// ------------------------------
enum WalletTransactionType {
  TOP_UP
  PURCHASE
  REFUND
  REFERRAL_COMMISSION
  BINARY_COMMISSION
  REWARD
  WITHDRAWAL
  ADJUSTMENT
  SPONSOR_INCOME
}

enum WalletTransactionStatus {
  PENDING
  SUCCESS
  FAILED
  REVERSED
}

enum WithdrawalStatus {
  PENDING
  PROCESSING
  APPROVED
  REJECTED
  PAID
  FAILED
}

model Wallet {
  id     String @id @default(auto()) @map("_id") @db.ObjectId
  userId String @unique @db.ObjectId
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  shoppingBalancePaise Int @default(0)
  earningsBalancePaise Int @default(0)

  transactions WalletTransaction[]
  withdrawals  WalletWithdrawal[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model WalletTransaction {
  id       String @id @default(auto()) @map("_id") @db.ObjectId
  walletId String @db.ObjectId
  wallet   Wallet @relation(fields: [walletId], references: [id], onDelete: Cascade)

  type   WalletTransactionType
  status WalletTransactionStatus @default(PENDING)

  amountPaise       Int
  balanceType       String // SHOPPING or EARNINGS
  balanceAfterPaise Int?

  description     String
  reference       String?
  paymentProvider String?
  paymentOrderId  String?
  paymentId       String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([walletId, createdAt])
  @@index([walletId, status])
  @@index([paymentOrderId])
  @@index([paymentId])
}

model WalletWithdrawal {
  id       String @id @default(auto()) @map("_id") @db.ObjectId
  walletId String @db.ObjectId
  wallet   Wallet @relation(fields: [walletId], references: [id], onDelete: Cascade)

  amountPaise Int
  status      WithdrawalStatus @default(PENDING)

  bankAccountName   String
  bankAccountNumber String
  ifscCode          String
  bankName          String?

  transactionId String?
  adminRemarks  String?
  processedAt   DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([walletId, createdAt])
  @@index([status])
}

enum ProductStatus {
  DRAFT
  ACTIVE
  INACTIVE
  ARCHIVED
}

model Product {
  id               String  @id @default(auto()) @map("_id") @db.ObjectId
  name             String
  slug             String  @unique
  sku              String  @unique
  shortDescription String?
  description      String?

  maxRetailPrice   Int
  distributorPrice Int
  amzcoins         Float

  stockQuantity     Int @default(0)
  lowStockThreshold Int @default(5)

  categoryId String?   @db.ObjectId
  category   Category? @relation(fields: [categoryId], references: [id])

  images ProductImage[]

  status     ProductStatus @default(DRAFT)
  isFeatured Boolean       @default(false)

  bogoEnabled           Boolean                      @default(false)
  bogoEligibleProducts  ProductBogoEligibleProduct[] @relation("BogoMainProduct")
  eligibleAsFreeProduct ProductBogoEligibleProduct[] @relation("BogoFreeProduct")

  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt
  cartItems     CartItem[]
  orderItems    OrderItem[]
  wishlistItems WishlistItem[]

  @@index([status, createdAt])
  @@index([categoryId, status])
}

model ProductBogoEligibleProduct {
  id String @id @default(auto()) @map("_id") @db.ObjectId

  productId String  @db.ObjectId
  product   Product @relation("BogoMainProduct", fields: [productId], references: [id], onDelete: Cascade)

  freeProductId String  @db.ObjectId
  freeProduct   Product @relation("BogoFreeProduct", fields: [freeProductId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  @@unique([productId, freeProductId])
  @@index([freeProductId])
}

model ProductImage {
  id        String  @id @default(auto()) @map("_id") @db.ObjectId
  productId String  @db.ObjectId
  product   Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  url       String
  key       String
  alt       String?
  position  Int     @default(0)
  isPrimary Boolean @default(false)

  createdAt DateTime @default(now())

  @@index([productId, position])
}

model Category {
  id       String  @id @default(auto()) @map("_id") @db.ObjectId
  name     String
  slug     String  @unique
  image    String?
  isActive Boolean @default(true)

  products Product[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Cart {
  id        String     @id @default(auto()) @map("_id") @db.ObjectId
  userId    String     @unique @db.ObjectId
  user      User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  items     CartItem[]
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt
}

model CartItem {
  id        String   @id @default(auto()) @map("_id") @db.ObjectId
  cartId    String   @db.ObjectId
  cart      Cart     @relation(fields: [cartId], references: [id], onDelete: Cascade)
  productId String   @db.ObjectId
  product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  quantity  Int      @default(1)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([cartId, productId])
  @@index([productId])
}

// 
enum FulfillmentMethod {
  STORE_PICKUP
  HOME_DELIVERY
}

enum OrderPaymentStatus {
  PENDING
  PAID
  FAILED
  REFUNDED
}

enum PaymentProvider {
  RAZORPAY
  CASHFREE
  PHONEPE
  MANUAL
  UPI_QR
  COD
}

type OrderAddress {
  recipientName String
  mobile        String
  addressLine   String
  district      String
  state         String
  pinCode       String
  country       String @default("India")
}

enum OrderStatus {
  PENDING
  PROCESSING
  SHIPPED
  DELIVERED
  CANCELLED
}

model Order {
  id          String @id @default(auto()) @map("_id") @db.ObjectId
  orderNumber String @unique

  userId String @db.ObjectId
  user   User   @relation(fields: [userId], references: [id])

  items OrderItem[]

  fulfillmentMethod FulfillmentMethod
  deliveryAddress   OrderAddress?

  subtotal       Int
  shippingCharge Int     @default(0)
  totalAmount    Int
  discountAmount Int     @default(0)
  couponCode     String?

  paymentStatus OrderPaymentStatus @default(PENDING)
  status        OrderStatus        @default(PENDING)

  payment Payment?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  storeId String? @db.ObjectId
  store   Store?  @relation(fields: [storeId], references: [id])

  pickupStoreName    String?
  pickupStoreContact String?
  pickupStoreAddress String?

  @@index([userId, createdAt])
  @@index([paymentStatus])
}

model OrderItem {
  id      String @id @default(auto()) @map("_id") @db.ObjectId
  orderId String @db.ObjectId
  order   Order  @relation(fields: [orderId], references: [id], onDelete: Cascade)

  productId String  @db.ObjectId
  product   Product @relation(fields: [productId], references: [id])

  productName  String
  sku          String
  quantity     Int
  freeQuantity Int    @default(0)

  unitPrice Int
  mrp       Int
  amzcoins  Float @default(0)

  createdAt DateTime @default(now())

  @@index([productId])
}

model Payment {
  id      String @id @default(auto()) @map("_id") @db.ObjectId
  orderId String @unique @db.ObjectId
  order   Order  @relation(fields: [orderId], references: [id], onDelete: Cascade)

  provider          PaymentProvider
  providerOrderId   String?
  providerPaymentId String?
  amount            Int
  currency          String             @default("INR")
  status            OrderPaymentStatus @default(PENDING)

  idempotencyKey String  @unique
  rawResponse    String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([providerPaymentId])
}

model PaymentGatewaySetting {
  id           String @id @default(auto()) @map("_id") @db.ObjectId
  singletonKey String @unique @default("DEFAULT")

  upiId        String  @default("amazeayurveda@upi")
  upiPayeeName String  @default("Amaze Ayurveda Pvt Ltd")
  customQrUrl  String? // Optional uploaded QR image; if blank, dynamic amount QR is generated from upiId
  upiQrEnabled Boolean @default(true)
  codEnabled   Boolean @default(true)
  paymentNote  String? @default("Scan QR with GPay, PhonePe, Paytm, or BHIM UPI and enter the 12-digit UTR.")

  updatedBy String?  @db.ObjectId
  updatedAt DateTime @updatedAt

  @@map("payment_gateway_settings")
}

model Store {
  id String @id @default(auto()) @map("_id") @db.ObjectId

  name             String
  code             String  @unique
  ownerName        String
  contactNumber    String
  alternateContact String?
  email            String?

  addressLine String
  landmark    String?
  city        String
  district    String
  state       String
  pinCode     String
  country     String  @default("India")

  latitude  Float?
  longitude Float?

  openingHours String?
  instructions String?

  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  orders Order[]

  @@index([isActive, city])
  @@index([district, state])
}

enum VerificationPurpose {
  EMAIL
  MOBILE
}

model VerificationChallenge {
  id String @id @default(auto()) @map("_id") @db.ObjectId

  userId String @db.ObjectId
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  purpose VerificationPurpose

  // Store only the SHA-256 hash, never the actual OTP
  otpHash String

  expiresAt         DateTime
  resendAvailableAt DateTime

  attempts Int @default(0)

  consumedAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId, purpose])
  @@index([expiresAt])
}

// Add to prisma/schema.prisma
enum CouponDiscountType {
  PERCENTAGE
  FLAT
}

model Coupon {
  id                String             @id @default(auto()) @map("_id") @db.ObjectId
  code              String             @unique // Stored uppercase, e.g. "AMAZE10", "FESTIVE200"
  title             String // Internal/offer label, e.g. "Diwali Wellness 15% Off"
  description       String?
  discountType      CouponDiscountType @default(PERCENTAGE)
  discountValue     Int // Percentage (e.g. 15) or Flat amount in INR (e.g. 200)
  minOrderAmount    Int                @default(0) // Minimum cart DP subtotal in INR
  maxDiscountAmount Int? // Optional max cap in INR for PERCENTAGE coupons
  usageLimit        Int? // Optional total redemptions cap across store
  perUserLimit      Int                @default(1)
  usedCount         Int                @default(0)
  isActive          Boolean            @default(false) // Admin toggle: activate only during offers
  startsAt          DateTime?
  expiresAt         DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([isActive])
  @@index([expiresAt])
}

// Add to User model in prisma/schema.prisma:
// rewardProgress  MemberRewardProgress?
// earnedRewards   MemberReward[]
// rewardClaims    RewardClaim[]

enum RewardSelectionType {
  PRODUCT
  CASH
}

enum RewardEligibilityStatus {
  ELIGIBLE
  CLAIMED
  CANCELLED
}

enum RewardClaimStatus {
  PENDING_APPROVAL
  APPROVED
  REJECTED
  DISPATCHED
  DELIVERED
  PAID_OUT
}

enum RewardDeliveryStatus {
  NOT_STARTED
  PACKING
  DISPATCHED
  IN_TRANSIT
  DELIVERED
  FAILED
}

model RewardSlab {
  id                 String  @id @default(auto()) @map("_id") @db.ObjectId
  level              Int     @unique // 1 to 13
  milestoneName      String
  requiredPaidPairs  Int     @unique // 5, 10, 25, 50, 100, ... 50000
  productName        String
  productImage       String?
  description        String?
  cashAlternativeInr Int? // Null for milestones 1–4 by default, configurable by Admin
  isCashAllowed      Boolean @default(false)
  isActive           Boolean @default(true)

  memberRewards MemberReward[]
  claims        RewardClaim[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([isActive, requiredPaidPairs])
  @@map("reward_slabs")
}

model MemberRewardProgress {
  id       String @id @default(auto()) @map("_id") @db.ObjectId
  memberId String @unique @db.ObjectId
  member   User   @relation(fields: [memberId], references: [id], onDelete: Cascade)

  lifetimePaidPairs  Int       @default(0)
  processedTxIds     String[]  @default([]) // Idempotency guard for verified BINARY_COMMISSION tx IDs
  lastPairCreditedAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("member_reward_progress")
}

model MemberReward {
  id       String @id @default(auto()) @map("_id") @db.ObjectId
  memberId String @db.ObjectId
  member   User   @relation(fields: [memberId], references: [id], onDelete: Cascade)

  rewardSlabId String     @db.ObjectId
  rewardSlab   RewardSlab @relation(fields: [rewardSlabId], references: [id])

  achievedAtPairs Int
  status          RewardEligibilityStatus @default(ELIGIBLE)
  earnedAt        DateTime                @default(now())

  claim RewardClaim?

  @@unique([memberId, rewardSlabId]) // Guarantees each milestone is awarded only once per member
  @@index([memberId, status])
  @@map("member_rewards")
}

model RewardClaim {
  id          String @id @default(auto()) @map("_id") @db.ObjectId
  claimNumber String @unique

  memberRewardId String       @unique @db.ObjectId
  memberReward   MemberReward @relation(fields: [memberRewardId], references: [id], onDelete: Cascade)

  memberId String @db.ObjectId
  member   User   @relation(fields: [memberId], references: [id])

  rewardSlabId String     @db.ObjectId
  rewardSlab   RewardSlab @relation(fields: [rewardSlabId], references: [id])

  selectionType   RewardSelectionType
  productSnapshot String
  cashAmountInr   Int?

  // Shipping snapshot when selectionType == PRODUCT
  recipientName   String?
  recipientMobile String?
  shippingAddress String?

  status       RewardClaimStatus @default(PENDING_APPROVAL)
  adminRemarks String?
  reviewedBy   String?           @db.ObjectId
  reviewedAt   DateTime?
  walletTxId   String?           @db.ObjectId

  delivery RewardDelivery?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([memberId, createdAt])
  @@index([status])
  @@map("reward_claims")
}

model RewardDelivery {
  id      String      @id @default(auto()) @map("_id") @db.ObjectId
  claimId String      @unique @db.ObjectId
  claim   RewardClaim @relation(fields: [claimId], references: [id], onDelete: Cascade)

  courierName    String?
  trackingNumber String?
  trackingUrl    String?
  dispatchNotes  String?
  status         RewardDeliveryStatus @default(NOT_STARTED)

  dispatchedAt DateTime?
  deliveredAt  DateTime?
  updatedBy    String?   @db.ObjectId

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("reward_delivery")
}

model RewardAuditLog {
  id          String  @id @default(auto()) @map("_id") @db.ObjectId
  adminId     String  @db.ObjectId
  entityType  String // "REWARD_SLAB" | "REWARD_CLAIM" | "REWARD_DELIVERY"
  entityId    String
  action      String // "SLAB_UPDATED" | "CLAIM_APPROVED" | "CLAIM_REJECTED" | "DISPATCH_UPDATED"
  beforeState String?
  afterState  String?
  remarks     String?

  createdAt DateTime @default(now())

  @@index([entityType, createdAt])
  @@map("reward_audit_logs")
}

// 
// Update RewardSlab to include milestoneName:
// milestoneName String // e.g., "Starter", "Bronze", ... "Legend"

model CompensationConfig {
  id           String @id @default(auto()) @map("_id") @db.ObjectId
  singletonKey String @unique @default("DEFAULT")

  activationMinAmzCoins Float   @default(1.0)
  sponsorCommissionInr  Int     @default(150)
  sponsorIncomeEnabled  Boolean @default(true)

  binaryPairCommissionInr Int     @default(200)
  binaryIncomeEnabled     Boolean @default(true)
  dailyMaxPaidPairs       Int     @default(20)

  minLeftActiveDirects  Int @default(1)
  minRightActiveDirects Int @default(1)

  updatedBy String?  @db.ObjectId
  updatedAt DateTime @updatedAt

  @@map("compensation_configs")
}

model BinaryBusinessBalance {
  id       String @id @default(auto()) @map("_id") @db.ObjectId
  memberId String @unique @db.ObjectId
  member   User   @relation(fields: [memberId], references: [id], onDelete: Cascade)

  leftAvailableCoins  Float @default(0)
  rightAvailableCoins Float @default(0)

  leftCarryForward  Float @default(0)
  rightCarryForward Float @default(0)

  leftLapsedTotal  Float @default(0)
  rightLapsedTotal Float @default(0)

  leftMemberCount  Int @default(0)
  rightMemberCount Int @default(0)

  lastMatchedDate String? // YYYY-MM-DD (IST)
  updatedAt       DateTime @updatedAt

  @@map("binary_business_balances")
}

model DailyPairSummary {
  id       String @id @default(auto()) @map("_id") @db.ObjectId
  memberId String @db.ObjectId
  member   User   @relation(fields: [memberId], references: [id], onDelete: Cascade)

  businessDate      String // YYYY-MM-DD (IST)
  matchedPairsCount Int    @default(0)
  paidPairsCount    Int    @default(0) // Max 20 per day
  earnedAmountInr   Int    @default(0)

  carriedForwardLeg   String? // "LEFT" | "RIGHT" | null
  carriedForwardCoins Float   @default(0)
  lapsedLeg           String? // "LEFT" | "RIGHT" | null
  lapsedCoins         Float   @default(0)
  tieBreakerUsed      String? // "COINS" | "MEMBER_COUNT" | "EARLIER_ACTIVATION"

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([memberId, businessDate])
  @@index([businessDate])
  @@map("daily_pair_summaries")
}

model CommissionLedger {
  id             String @id @default(auto()) @map("_id") @db.ObjectId
  idempotencyKey String @unique // Prevents duplicate sponsor or binary payout for same source event
  memberId       String @db.ObjectId
  member         User   @relation(fields: [memberId], references: [id])

  commissionType  String // "SPONSOR_INCOME" | "BINARY_MATCHING" | "REVERSAL"
  amountInr       Int
  pairsCount      Int     @default(0)
  sourceReference String // e.g. activatedUserId or "BINARY:memberId:2026-11-15:PAIR_1"
  walletTxId      String? @db.ObjectId
  status          String  @default("CREDITED") // "CREDITED" | "REVERSED"

  createdAt DateTime @default(now())

  @@index([memberId, createdAt])
  @@map("commission_transactions")
}

enum AnnouncementIcon {
  TAG
  SPARKLES
}

model FlashAnnouncement {
  id        String           @id @default(auto()) @map("_id") @db.ObjectId
  badge     String? // e.g., "100% PURE", "MEMBER OFFER"
  text      String // Main ticker message
  href      String? // Optional link e.g., "/shop"
  ctaLabel  String? // Optional button label e.g., "Shop Now"
  icon      AnnouncementIcon @default(SPARKLES)
  sortOrder Int              @default(0)
  isActive  Boolean          @default(true)
  startsAt  DateTime?
  expiresAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([isActive, sortOrder])
  @@map("flash_announcements")
}

model Wishlist {
  id        String         @id @default(auto()) @map("_id") @db.ObjectId
  userId    String         @unique @db.ObjectId
  user      User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  items     WishlistItem[]
  createdAt DateTime       @default(now())
  updatedAt DateTime       @updatedAt

  @@map("wishlists")
}

model WishlistItem {
  id         String   @id @default(auto()) @map("_id") @db.ObjectId
  wishlistId String   @db.ObjectId
  wishlist   Wishlist @relation(fields: [wishlistId], references: [id], onDelete: Cascade)
  productId  String   @db.ObjectId
  product    Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  createdAt  DateTime @default(now())

  @@unique([wishlistId, productId])
  @@index([productId])
  @@map("wishlist_items")
}
