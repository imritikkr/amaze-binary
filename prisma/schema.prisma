// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Looking for ways to speed up your queries, or scale easily with your serverless or edge functions?
// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

generator client {
  provider = "prisma-client-js"
  output   = "../src/generated/prisma"
  // binaryTargets = ["native", "rhel-openssl-3.0.x"]
}

datasource db {
  provider = "mongodb"
  url      = env("DATABASE_URL")
}

enum Role {
  MEMBER
  ADMIN
  SUPER_ADMIN
}

enum AccountStatus {
  ACTIVE
  INACTIVE
  SUSPENDED
  TERMINATED
}

enum KycStatus {
  NOT_SUBMITTED
  PENDING
  APPROVED
  REJECTED
  RESUBMISSION_REQUIRED
}

enum ActivationStatus {
  FREE
  ACTIVE
  INACTIVE
}

enum BinaryPosition {
  LEFT
  RIGHT
}

model User {
  id               String           @id @default(auto()) @map("_id") @db.ObjectId
  userId           String           @unique // 9-digit unique public ID (e.g. 847291038)
  name             String
  avatarUrl        String?
  fatherName       String?
  gender           Gender?
  dateOfBirth      DateTime?
  mobile           String           @unique
  email            String?
  passwordHash     String
  firebaseUid      String?
  phoneVerified    Boolean          @default(false)
  emailVerified    Boolean          @default(false)
  role             Role             @default(MEMBER)
  accountStatus    AccountStatus    @default(ACTIVE)
  kycStatus        KycStatus        @default(NOT_SUBMITTED)
  activationStatus ActivationStatus @default(FREE)

  // Direct Sponsor Relationship (Unilevel Lineage)
  sponsorId        String? @db.ObjectId
  sponsor          User?   @relation("DirectReferrals", fields: [sponsorId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  sponsoredMembers User[]  @relation("DirectReferrals")

  // Registration verification access
  pendingVerificationTokenHash String?
  pendingVerificationExpiresAt DateTime?

  // Verification challenges
  verificationChallenges VerificationChallenge[]

  binaryPlacement BinaryPlacement? @relation("UserBinaryPlacement")
  // Structural Binary Node References

  // Auth, Tokens & Audit Relations
  sessions        AuthSession[]
  loginHistories  LoginHistory[]
  kycRecord       Kyc?
  kycReviewsGiven KycReviewHistory[] @relation("AdminKycReviews")

  // Embedded Profile Details
  address     ProfileAddress?
  bankDetails BankDetails?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  wallet    Wallet?
  cart      Cart?
  orders    Order[]

  rewardProgress        MemberRewardProgress?
  earnedRewards         MemberReward[]
  rewardClaims          RewardClaim[]
  binaryBusinessBalance BinaryBusinessBalance?
  dailyPairSummaries    DailyPairSummary[]
  commissionLedgers     CommissionLedger[]

  activatedAt DateTime?
  wishlist    Wishlist?

  @@index([sponsorId])
  @@index([accountStatus])
  @@index([createdAt])
}

enum Gender {
  MALE
  FEMALE
  OTHER
}

type ProfileAddress {
  addressLine String?
  district    String?
  state       String?
  pinCode     String?
  country     String? @default("India")
}

type BankDetails {
  accountHolderName String?
  bankName          String?
  accountNumber     String? // Stored encrypted/plain server-side, masked on output
  ifscCode          String?
  branchName        String?
  isVerified        Boolean   @default(false)
  updatedAt         DateTime?
}

model BinaryPlacement {
  id     String @id @default(auto()) @map("_id") @db.ObjectId
  userId String @unique @db.ObjectId
  user   User   @relation("UserBinaryPlacement", fields: [userId], references: [id], onDelete: Cascade)

  parentId String?           @db.ObjectId
  parent   BinaryPlacement?  @relation("BinaryHierarchy", fields: [parentId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  children BinaryPlacement[] @relation("BinaryHierarchy")

  position BinaryPosition // LEFT | RIGHT
  treePath String // Slash-delimited ObjectId chain: "/rootId/.../parentId/userId"
  depth    Int            @default(0)

  // Cached aggregate counters to prevent full-tree recalculations on every dashboard load
  leftCount  Int   @default(0)
  rightCount Int   @default(0)
  leftBv     Float @default(0)
  rightBv    Float @default(0)

  createdAt DateTime  @default(now())
  updatedAt DateTime? @default(now()) @updatedAt

  @@unique([parentId, position]) // Guarantees only one LEFT and one RIGHT child per parent node
  @@index([treePath])
  @@index([parentId])
  @@index([depth])
}

